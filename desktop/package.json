{
  "name": "desk-assistant",
  "version": "0.25.0",
  "description": "Riyeser Desk Assistant: sorts your files, tracks meetings and to-dos, and edits PDFs.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-timeout=120000 --test-force-exit test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "node scripts/package-win.js assistant",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "node scripts/vendor.js",
    "predist": "node scripts/vendor.js",
    "dist:pdf": "node scripts/package-win.js pdf",
    "dist:all": "node scripts/package-win.js"
  },
  "author": {
    "name": "Riyeser"
  },
  "license": "UNLICENSED",
  "copyright": "Copyright © 2026 Riyeser. All rights reserved.",
  "devDependencies": {
    "@cantoo/pdf-lib": "2.9.2",
    "@pdf-lib/fontkit": "1.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "pdfjs-dist": "^4.10.38",
    "pe-library": "^2.0.1",
    "resedit": "^2.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^8.5.0",
    "exifr": "^7.1.3",
    "imapflow": "^2.11.0",
    "jszip": "^3.10.2",
    "mailparser": "^3.14.3",
    "mammoth": "^1.13.0",
    "node-ical": "^0.27.6",
    "pdf-lib": "^1.17.1",
    "sql.js": "^1.11.0",
    "tesseract.js": "^5.1.1",
    "unpdf": "^1.9.1"
  },
  "productName": "Riyeser Desk Assistant",
  "build": {
    "appId": "com.deskassistant.app",
    "productName": "Riyeser Desk Assistant",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/eng/4.0.0_best_int/**",
      "node_modules/{bmp-js,idb-keyval,is-electron,is-url,node-fetch,whatwg-url,tr46,webidl-conversions,opencollective-postinstall,regenerator-runtime,wasm-feature-detect,zlibjs}/**"
    ]
  },
  "private": true
}
